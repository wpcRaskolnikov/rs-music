{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "rs-music",
  "version": "3.3.7",
  "identifier": "com.wpc.rs-music",
  "build": {
    "beforeDevCommand": "yarn dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "yarn build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "rs-music",
        "decorations": false,
        "minWidth": 800,
        "minHeight": 600,
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDUyRTRFRTA0NkZFNENDMEMKUldRTXpPUnZCTzdrVW5TZ256dThTTjd6bTR6WERUWXU4YVU4Z3EzSlZ6bFJSY3dpU3MrSVYyRGUK",
      "endpoints": [
        "https://github.com/wpcRaskolnikov/rs-music/releases/latest/download/latest.json"
      ]
    }
  }
}
